{
  "bases": {
    "add-arpneighbors": {
      "kind": "AddARPNeighborsRequest",
      "request": {
        "neighbors": {
          "ARPNeighbors": [
            {
              "device": "eth0",
              "flags": 0,
              "lladdr": "00:00:5e:00:53:01",
              "state": 128,
              "toIPAddress": {
                "address": "10.0.0.1",
                "family": 0,
                "mask": ""
              }
            }
          ]
        }
      }
    }
  },
  "cases": [
    {
      "description": "compliant neighbors",
      "base": "add-arpneighbors",
      "allowed": true,
      "patch": []
    },
    {
      "description": "allowed state: reachable",
      "base": "add-arpneighbors",
      "allowed": true,
      "patch": [
        {
          "op": "replace",
          "path": "/neighbors/ARPNeighbors/0/state",
          "value": 2
        }
      ]
    },
    {
      "description": "allowed flags: NTF_PROXY",
      "base": "add-arpneighbors",
      "allowed": true,
      "patch": [
        {
          "op": "replace",
          "path": "/neighbors/ARPNeighbors/0/flags",
          "value": 8
        }
      ]
    },
    {
      "description": "allowed flags: NTF_ROUTER",
      "base": "add-arpneighbors",
      "allowed": true,
      "patch": [
        {
          "op": "replace",
          "path": "/neighbors/ARPNeighbors/0/flags",
          "value": 128
        }
      ]
    },
    {
      "description": "bad interface",
      "base": "add-arpneighbors",
      "allowed": false,
      "patch": [
        {
          "op": "replace",
          "path": "/neighbors/ARPNeighbors/0/device",
          "value": "lo"
        }
      ]
    },
    {
      "description": "bad IP",
      "base": "add-arpneighbors",
      "allowed": false,
      "patch": [
        {
          "op": "replace",
          "path": "/neighbors/ARPNeighbors/0/toIPAddress/address",
          "value": "127.1.2.3"
        }
      ]
    },
    {
      "description": "bad state",
      "base": "add-arpneighbors",
      "allowed": false,
      "patch": [
        {
          "op": "replace",
          "path": "/neighbors/ARPNeighbors/0/state",
          "value": 0
        }
      ]
    },
    {
      "description": "bad flags",
      "base": "add-arpneighbors",
      "allowed": false,
      "patch": [
        {
          "op": "replace",
          "path": "/neighbors/ARPNeighbors/0/flags",
          "value": 5
        }
      ]
    }
  ]
}
