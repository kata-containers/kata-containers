{
  "bases": {
    "create-sandbox": {
      "kind": "CreateSandboxRequest",
      "request": {
        "sandbox_pidns": false
      }
    }
  },
  "cases": [
    {
      "description": "no pidns",
      "base": "create-sandbox",
      "allowed": true,
      "patch": []
    },
    {
      "description": "pidns",
      "base": "create-sandbox",
      "allowed": false,
      "patch": [
        {
          "op": "replace",
          "path": "/sandbox_pidns",
          "value": true
        }
      ]
    },
    {
      "description": "kernel modules",
      "base": "create-sandbox",
      "allowed": false,
      "patch": [
        {
          "op": "add",
          "path": "/kernel_modules",
          "value": [
            {
              "name": "evil.ko"
            }
          ]
        }
      ]
    },
    {
      "description": "guest hooks",
      "base": "create-sandbox",
      "allowed": false,
      "patch": [
        {
          "op": "add",
          "path": "/guest_hook_path",
          "value": "/attacker/controlled/path"
        }
      ]
    }
  ]
}
