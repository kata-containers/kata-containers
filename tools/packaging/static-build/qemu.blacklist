#
# List of blacklisted files that are not
# required in kata and may have CVEs.
#
qemu_black_list=(
*/bin/qemu-pr-helper
*/bin/virtfs-proxy-helper
*/libexec/kata-qemu/qemu*
*/share/*/applications
*/share/*/*.dtb
*/share/*/efi-e1000e.rom
*/share/*/efi-e1000.rom
*/share/*/efi-eepro100.rom
*/share/*/efi-ne2k_pci.rom
*/share/*/efi-pcnet.rom
*/share/*/efi-rtl8139.rom
*/share/*/efi-vmxnet3.rom
*/share/*/icons
*/share/*/keymaps
*/share/*/multiboot.bin
*/share/*/npcm7xx_bootrom.bin
*/share/*/openbios-ppc
*/share/*/openbios-sparc32
*/share/*/openbios-sparc64
*/share/*/opensbi-riscv*
*/share/*/palcode-clipper
*/share/*/pxe-*
*/share/*/QEMU,*
*/share/*/qemu_vga.ndrv
*/share/*/sgabios.bin
*/share/*/skiboot.lid
*/share/*/trace-events-all
*/share/*/u-boot*
*/share/*/vgabios*
)

# Firmware files not needed for this architecture.
# Each platform uses a different firmware, ship only what's required:
#   x86_64  -> edk2-x86_64-*.fd (OVMF)
#   aarch64 -> edk2-aarch64-*.fd (AAVMF)
#   s390x   -> s390-ccw.img (CCW BIOS)
#   ppc64le -> slof.bin / vof.bin (Open Firmware)
ARCH=${ARCH:-$(uname -m)}
case "${ARCH}" in
x86_64)
    qemu_black_list+=(
        */share/*/edk2-aarch64*
        */share/*/edk2-arm*
        */share/*/edk2-i386*
        */share/*/edk2-loongarch64*
        */share/*/edk2-riscv*
        */share/*/firmware/60-edk2-aarch64.json
        */share/*/firmware/60-edk2-arm.json
        */share/*/firmware/60-edk2-i386.json
        */share/*/firmware/60-edk2-loongarch64.json
        */share/*/firmware/60-edk2-riscv64.json
        */share/*/hppa-firmware*
        */share/*/pnv-pnor.bin
        */share/*/s390-ccw.img
        */share/*/slof.bin
        */share/*/vof*.bin
        */share/*/ast27x0_bootrom.bin
        */share/*/npcm8xx_bootrom.bin
    )
    ;;
aarch64)
    qemu_black_list+=(
        */share/*/edk2-arm-*
        */share/*/edk2-i386*
        */share/*/edk2-loongarch64*
        */share/*/edk2-riscv*
        */share/*/edk2-x86_64*
        */share/*/firmware/50-edk2-*
        */share/*/firmware/60-edk2-arm.json
        */share/*/firmware/60-edk2-i386.json
        */share/*/firmware/60-edk2-loongarch64.json
        */share/*/firmware/60-edk2-riscv64.json
        */share/*/firmware/60-edk2-x86_64.json
        */share/*/hppa-firmware*
        */share/*/pnv-pnor.bin
        */share/*/s390-ccw.img
        */share/*/slof.bin
        */share/*/vof*.bin
        */share/*/ast27x0_bootrom.bin
        */share/*/npcm8xx_bootrom.bin
        */share/*/bios*.bin
        */share/*/kvmvapic.bin
        */share/*/linuxboot_dma.bin
        */share/*/multiboot_dma.bin
        */share/*/pvh.bin
        */share/*/qboot.rom
    )
    ;;
s390x)
    qemu_black_list+=(
        */share/*/edk2-*
        */share/*/firmware
        */share/*/hppa-firmware*
        */share/*/pnv-pnor.bin
        */share/*/slof.bin
        */share/*/vof*.bin
        */share/*/ast27x0_bootrom.bin
        */share/*/npcm8xx_bootrom.bin
        */share/*/bios*.bin
        */share/*/kvmvapic.bin
        */share/*/linuxboot_dma.bin
        */share/*/multiboot_dma.bin
        */share/*/pvh.bin
        */share/*/qboot.rom
    )
    ;;
ppc64le)
    qemu_black_list+=(
        */share/*/edk2-*
        */share/*/firmware
        */share/*/hppa-firmware*
        */share/*/pnv-pnor.bin
        */share/*/s390-ccw.img
        */share/*/ast27x0_bootrom.bin
        */share/*/npcm8xx_bootrom.bin
        */share/*/bios*.bin
        */share/*/kvmvapic.bin
        */share/*/linuxboot_dma.bin
        */share/*/multiboot_dma.bin
        */share/*/pvh.bin
        */share/*/qboot.rom
    )
    ;;
esac

# The runtime classes this build serves always name the firmware they want:
# either none at all, for a direct kernel boot, or the OVMF that the ovmf
# artifact installs.  None of the UEFI images QEMU bundles is ever loaded, so
# drop them along with the descriptors pointing at them; SeaBIOS and the
# direct-boot option ROMs stay, x86_64 still boots through them.
if [[ "${BUILD_SUFFIX:-}" == "microvm" ]]; then
    # microvm boots through bios-microvm.bin (qboot) and pvh.bin, and builds no
    # other machine.  Everything else QEMU bundles is left without a consumer:
    # there is no PCI bus for efi-virtio.rom and no q35 for the 256K SeaBIOS.
    qemu_black_list+=(
        */share/*/edk2-*
        */share/*/firmware
        */share/*/bios.bin
        */share/*/bios-256k.bin
        */share/*/efi-virtio.rom
        */share/*/kvmvapic.bin
        */share/*/linuxboot_dma.bin
        */share/*/multiboot_dma.bin
        */share/*/qboot.rom
        */share/*/qemu-nsis.bmp
        */share/*/dtb
        */include
        */lib
    )
fi

if [[ "${BUILD_SUFFIX:-}" == "no-shared-fs" ]]; then
    qemu_black_list+=(
        */share/*/edk2-*
        */share/*/firmware
    )
    # q35 is the only machine the allowlist builds, and it boots through
    # bios-256k.bin: the 128K SeaBIOS, the microvm firmware and qboot are left
    # without a machine to serve, and multiboot only loads non-Linux kernels.
    # efi-virtio.rom stays: it is the class default romfile of virtio-net-pci,
    # which neither runtime overrides, and QEMU refuses to realise the device
    # when the file is missing.
    qemu_black_list+=(
        */share/*/bios.bin
        */share/*/bios-microvm.bin
        */share/*/multiboot_dma.bin
        */share/*/qboot.rom
    )
    # Nothing here is reachable at run time either: the Windows installer
    # artwork, the empty directory the *.dtb removal above leaves behind, and
    # the headers, static library and pkg-config file the bundled dtc
    # subproject installs.  The build enables no QEMU module, so include/ and
    # lib/ hold those build-time leftovers and nothing else.
    qemu_black_list+=(
        */share/*/qemu-nsis.bmp
        */share/*/dtb
        */include
        */lib
    )
fi
